{
  "name": "adbex",
  "version": "1.1.0",
  "author": "JSleim",
  "description": "A friendlier ADB wrapper - glob pulls, APK extraction, screenshots, backups and more",
  "main": "src/index.js",
  "bin": {
    "adbex": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "build:labels": "powershell -NoProfile -ExecutionPolicy Bypass -File src/java/build.ps1"
  },
  "keywords": [
    "adb",
    "android",
    "cli",
    "file-transfer",
    "apk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "adbex": "file:adbex-1.1.0.tgz"
  }
}
